# Fail `npm install` loudly on a Node version outside package.json "engines"
# instead of silently succeeding on an untested version and failing later in a
# way that looks like a project bug. The floor in "engines" was derived from
# the strictest of our own devDependencies' declared Node requirements
# (vitest, eslint) — see the comment on "engines" in package.json.
engine-strict=true
