# ---------------------------------------------------------------------------
# CvScreener — example environment configuration
#
# Copy to `.env` and adjust:    Copy-Item .env.example .env     (PowerShell)
#                              cp .env.example .env            (bash)
#
# `.env` is git-ignored. This file contains PLACEHOLDERS ONLY — never put a
# real secret in it, because this file IS committed.
#
# The backend loads this file at startup and FAILS FAST with a message naming
# the offending variable if anything required is missing or invalid.
# The frontend reads its own frontend/.env (see frontend/.env.example).
# ---------------------------------------------------------------------------

# --- Application ----------------------------------------------------------
APP_ENV=development           # development | production
LOG_LEVEL=info                # debug | info | warning | error

# --- Database -------------------------------------------------------------
# REQUIRED. The backend refuses to start without it.
#
# The "+psycopg" suffix selects psycopg 3, which is what requirements.txt
# installs. A bare "postgresql://" URL makes SQLAlchemy look for psycopg2,
# which is NOT installed, and fails with ModuleNotFoundError.
#
# Credentials below match docker-compose.yml and are development-only.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_cv_screener

# --- Demo mode ------------------------------------------------------------
# The OUTER switch, checked before anything else. When true, every AI call is
# served from a recording in backend/app/llm/fixtures/: no model runs, no
# server is needed, no key is needed, and every run gives identical results.
# This is the default, and it is what makes a fresh clone work immediately.
#
# There is no fallback in either direction: demo mode never contacts a model,
# and a model is never replaced by a recording. Set this to false to run real
# inference over your own criteria and CVs.
DEMO_MODE=true

# --- AI provider ----------------------------------------------------------
# Which provider answers when DEMO_MODE=false. Only consulted then.
#
#   ollama     a model running on this machine. No account, no API key, no
#              per-call cost. The default, and the one for local development.
#   deepseek   the DeepSeek API, for a hosted deployment. Requires
#              DEEPSEEK_API_KEY, and every run sends your criteria and CVs to
#              a third party and costs money.
#   openrouter the OpenRouter gateway, a separate provider from deepseek.
#              Requires OPENROUTER_API_KEY; the model is OPENROUTER_MODEL. Every
#              run sends your criteria and CVs to OpenRouter and on to an
#              upstream provider it chooses, and costs money.
#   anthropic  the Anthropic cloud API. Requires ANTHROPIC_API_KEY, and every
#              run sends your criteria and CVs to a third party and costs money.
LLM_PROVIDER=ollama

# --- Ollama (LLM_PROVIDER=ollama) -----------------------------------------
# Ollama must be installed and running, and the model must be pulled ONCE:
#
#     ollama serve                      # if it is not already running
#     ollama pull qwen2.5:7b-instruct   # ~4.7 GB, one time
#     python scripts/check_llm.py --preflight
#
# qwen2.5:7b-instruct is the default because it holds a JSON schema well and
# handles Indonesian and English — see docs/decisions/0011. On a machine with
# less than ~8 GB of free RAM, use qwen2.5:3b-instruct instead: it is smaller
# and faster, and less reliable at returning valid structured output.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# How long to wait for one generation. Generous on purpose: a 7B model on a
# laptop CPU can take a minute on a long CV, and a timeout that fires mid-answer
# looks like a broken product rather than a slow one.
OLLAMA_TIMEOUT_SECONDS=300

# --- DeepSeek (LLM_PROVIDER=deepseek) -------------------------------------
# Server-side only, like every key here: it must never reach the browser bundle,
# and it is not read at all unless LLM_PROVIDER=deepseek and DEMO_MODE=false.
#
# Leave it EMPTY in this file. Put your own key in .env (or, in a deployment,
# in the platform's secret store). An empty key with LLM_PROVIDER=deepseek is a
# startup failure that names this variable, rather than a 401 at the first CV.
DEEPSEEK_API_KEY=

# The API root; the client adds /chat/completions. Must be https:// -- the key
# is sent with every request -- except to localhost.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# The whole call, including time spent in DeepSeek's queue under load.
DEEPSEEK_TIMEOUT_SECONDS=180

# Check it before opening the UI. This lists the models the key can use and
# spends no tokens:
#
#     python scripts/check_llm.py --preflight

# --- OpenRouter (LLM_PROVIDER=openrouter) ---------------------------------
# A separate provider, with its own key. An OpenRouter key does not work as
# DEEPSEEK_API_KEY (api.deepseek.com answers 401), and DEEPSEEK_API_KEY is never
# read for OpenRouter.
#
# Leave it EMPTY in this file. Put the key in .env, or in a deployment in the
# platform's secret store. Replacing one key with another is a change to this
# value only -- never to source code -- followed by a restart of the backend.
#
# Use your own key for real CVs: the settings of the account that owns the key
# (logging, which providers it allows) apply to every CV sent with it. A
# borrowed or shared key is for synthetic test data only.
OPENROUTER_API_KEY=

# The API root; the client adds /chat/completions. Must be https:// -- the key
# is sent with every request -- except to localhost.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# An exact OpenRouter model slug. Pinned rather than a "~...-latest" alias, so
# the model recorded against every call does not change underneath it.
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# The whole call.
OPENROUTER_TIMEOUT_SECONDS=180

# Every request sets provider.require_parameters=true, so OpenRouter uses only
# upstream providers that support every parameter sent, and
# provider.data_collection=deny, which asks OpenRouter to exclude providers that
# may store data. That narrows where a CV can go; it does not name the
# provider, and it is not a guarantee about what any provider does. Check the
# key and the model before opening the UI; this spends no tokens:
#
#     python scripts/check_llm.py --preflight

# --- Anthropic (LLM_PROVIDER=anthropic) -----------------------------------
# Server-side only. This key must never reach the browser bundle, and it is not
# read at all unless LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# The model the bundled RECORDINGS were made against. It is part of a fixture's
# key, so changing it invalidates every recording and breaks demo mode. It is
# not the model Ollama, DeepSeek or OpenRouter runs — those are OLLAMA_MODEL,
# DEEPSEEK_MODEL and OPENROUTER_MODEL above.
LLM_MODEL=claude-opus-5

# --- Frontend / CORS ------------------------------------------------------
# Comma-separated list of allowed origins. Never use "*" in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Upload limits (enforced from Phase 5) --------------------------------
# A CV is a document, not a media file: 10 MB is generous for a text-layer PDF
# and small enough that a batch of 25 stays bounded. The page limit rejects a
# report-sized document that is unlikely to be a CV.
MAX_UPLOAD_SIZE_MB=10
MAX_FILES_PER_BATCH=25
MAX_PDF_PAGES=20

# --- Request limits -------------------------------------------------------
# A ceiling on the whole request body, refused from Content-Length before any
# of it is read. Sized to hold a full batch of maximum-size CVs plus multipart
# overhead, so it never refuses a request the per-file limits would accept.
MAX_REQUEST_BODY_MB=300

# A per-client cap on the endpoints that cost money (extraction, profiling,
# matching) or write files (upload). IN-PROCESS ONLY: two workers means two
# independent allowances, and the client address is spoofable. It is a brake on
# accidental hammering, not a defence — a real deployment puts a rate limit in
# the reverse proxy in front of this. Set RATE_LIMIT_ENABLED=false for a
# single-user local run.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30

# --- Document storage -----------------------------------------------------
# Where uploaded CV PDFs are written. Defaults to <repo>/var/uploads, which is
# git-ignored. Uploaded CVs are personal data and must never be committed.
# Paths stored in the database are relative to this root, so it can move
# between environments without a data migration.
# UPLOAD_STORAGE_DIR=/var/lib/ai-cv-screener/uploads
