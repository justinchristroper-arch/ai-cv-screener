# ---------------------------------------------------------------------------
# AI CV Screener — example environment configuration
#
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored. This file contains PLACEHOLDERS ONLY — never put a
# real secret in it, because this file IS committed.
#
# Phase 0 note: no application reads these variables yet. The list is the
# planned configuration surface and is finalized in Phase 2, when the backend
# skeleton actually loads it.
# ---------------------------------------------------------------------------

# --- Application ----------------------------------------------------------
APP_ENV=development           # development | production
LOG_LEVEL=info                # debug | info | warning | error

# --- LLM provider ---------------------------------------------------------
# Server-side only. This key must never reach the browser bundle.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
LLM_MODEL=claude-opus-5

# --- Demo mode ------------------------------------------------------------
# When true, all LLM calls are served from recorded fixtures instead of the
# live API: no key required, no cost, identical results on every run.
# This is the default for the public demo (Phase 12).
DEMO_MODE=true

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_cv_screener

# --- Frontend / CORS ------------------------------------------------------
# Comma-separated list of allowed origins. Never use "*" in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Upload limits (Phase 5) ----------------------------------------------
MAX_UPLOAD_SIZE_MB=10
MAX_FILES_PER_BATCH=25
MAX_PDF_PAGES=20
